# Copia questo file in ".env" e modifica. NESSUNA chiave API è necessaria.

# --- Identità ---
NOME_ASSISTENTE=Aria
NOME_UTENTE=Shanks
# Il tuo numero: serve a riconoscere i numeri "quasi uguali al tuo" (spoofing)
OWN_NUMBER=

# --- Sicurezza (obbligatoria se usi --lan) ---
# Password richiesta da tutte le chiamate /api. L'interfaccia te la chiede la prima volta.
Aria_TOKEN=

# --- Cervello locale (facoltativo ma consigliato per le conversazioni libere) ---
# Ollama: https://ollama.com  ->  ollama pull qwen2.5:7b   (leggero)  oppure  qwen2.5:7b (più bravo in italiano)
LLM_BACKEND=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
# In alternativa un server locale compatibile OpenAI (llama.cpp server, LM Studio): LLM_BACKEND=openai
# LLM_URL=http://127.0.0.1:8080
# LLM_MODEL=local

# --- Email via IMAP (password per app, non la password normale) ---
# Gmail: Account Google > Sicurezza > Verifica in due passaggi > Password per le app
IMAP_HOST=
IMAP_USER=
IMAP_PASS=
IMAP_POLL_MIN=5

# --- Trascrizione offline (se installi faster-whisper): tiny | base | small | medium ---
WHISPER_MODEL=base
